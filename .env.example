# Local-only development values. Change the password for your machine.
POSTGRES_USER=self_healing
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=self_healing
DATABASE_HOST_PORT=5433
BACKEND_PORT=3001
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_APP_PORT=4000
MONITORED_CONTAINERS=self-healing-demo-app
MONITOR_INTERVAL_MS=5000
EVIDENCE_LOG_TAIL_LINES=100
EVIDENCE_LOG_MAX_BYTES=65536
EVIDENCE_COLLECTION_TIMEOUT_MS=5000
# Match the Docker socket's group id: stat -c '%g' /var/run/docker.sock
DOCKER_GID=129
