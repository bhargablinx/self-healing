# Local-only development values. Change the password for your machine.
POSTGRES_USER=self_healing
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=self_healing
BACKEND_PORT=3001
DEMO_APP_PORT=4000
MONITORED_CONTAINERS=self-healing-demo-app
MONITOR_INTERVAL_MS=5000
# Match the Docker socket's group id: stat -c '%g' /var/run/docker.sock
DOCKER_GID=129
