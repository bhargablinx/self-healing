generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  UNKNOWN
  RUNNING
  STOPPED
  UNAVAILABLE
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY
  NOT_CONFIGURED
}

enum IncidentType {
  CONTAINER_STOPPED
  CONTAINER_UNHEALTHY
  CONTAINER_UNAVAILABLE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
}

enum EvidenceType {
  CONTAINER_STATE
  CONTAINER_LOGS
  EXIT_CODE
  HEALTH_CHECK
  RESTART_COUNT
  CONTAINER_METADATA
}

enum EvidenceCollectionStatus {
  COMPLETE
  PARTIAL
  FAILED
}

enum DiagnosisType {
  APPLICATION_CRASH
  OUT_OF_MEMORY
  HEALTH_CHECK_FAILURE
  STARTUP_FAILURE
  CONTAINER_UNAVAILABLE
  UNKNOWN_FAILURE
}

enum DiagnosisConfidence {
  LOW
  MEDIUM
  HIGH
  INCONCLUSIVE
}

enum DiagnosisMethod {
  RULE_BASED
  LLM
}

model Service {
  id            String        @id @default(cuid())
  name          String
  containerId   String        @unique
  status        ServiceStatus @default(UNKNOWN)
  healthStatus  HealthStatus  @default(UNKNOWN)
  isEnabled     Boolean       @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  incidents     Incident[]

  @@index([isEnabled, status])
  @@map("services")
}

model Incident {
  id               String             @id @default(cuid())
  serviceId        String
  incidentType     IncidentType
  severity         IncidentSeverity   @default(MEDIUM)
  description      String
  status           IncidentStatus     @default(ACTIVE)
  deduplicationKey String?            @unique
  detectedAt       DateTime           @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  service          Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  evidence         IncidentEvidence[]
  diagnoses        Diagnosis[]

  @@index([serviceId, incidentType, status])
  @@index([status, detectedAt])
  @@map("incidents")
}

model IncidentEvidence {
  id               String                   @id @default(cuid())
  incidentId       String
  evidenceType     EvidenceType
  content          Json
  collectedAt      DateTime                 @default(now())
  collectionStatus EvidenceCollectionStatus @default(COMPLETE)
  collectionError  String?
  incident         Incident                 @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, evidenceType])
  @@index([incidentId, collectedAt])
  @@map("incident_evidence")
}

model Diagnosis {
  id                 String              @id @default(cuid())
  incidentId         String
  diagnosisType      DiagnosisType
  probableCause      String
  explanation        String
  confidence         DiagnosisConfidence
  supportingEvidence Json
  missingEvidence    Json
  diagnosisMethod    DiagnosisMethod     @default(RULE_BASED)
  createdAt          DateTime            @default(now())
  incident           Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([incidentId, diagnosisMethod, createdAt])
  @@map("diagnoses")
}
